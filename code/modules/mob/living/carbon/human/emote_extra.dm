/datum/emote/living/carbon/human/glasses/can_run_emote(mob/living/carbon/human/user, status_check = TRUE, intentional)
	. = ..()
	if(!.)
		return
	if(!user.glasses)
		to_chat(user, SPAN_WARNING("You are not wearing any glasses."))
		return FALSE

/datum/emote/living/carbon/human/jump
	key = "jump"
	key_third_person = "jumps"
	message = "jumps!"
	sound = 'sound/weapons/thudswoosh.ogg'
	global_audio_cooldown = FALSE

/datum/emote/living/carbon/human/jump/run_emote(mob/user, params, type_override, intentional)
	. = ..()
	if(!.)
		return
	var/start_y = user.pixel_y
	animate(user, pixel_y = start_y + 8, time = 2, easing = SINE_EASING|EASE_OUT, flags = ANIMATION_PARALLEL)
	animate(pixel_y = start_y, time = 2, easing = SINE_EASING|EASE_IN)

