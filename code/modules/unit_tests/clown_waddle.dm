/datum/unit_test/clown_waddle/Run()
	var/mob/living/carbon/human/clown = allocate(/mob/living/carbon/human)
	clown.create_hud()
	var/datum/element/waddling/waddle = SSdcs.GetElement(list(/datum/element/waddling))
	var/obj/item/clothing/shoes/clown_shoes/shoes = allocate(/obj/item/clothing/shoes/clown_shoes)
	TEST_ASSERT(clown.equip_to_slot_if_possible(shoes, WEAR_FEET), "The clown shoes did not go on")
	TEST_ASSERT(waddle.signal_procs?[clown], "Clown shoes did not make the wearer waddle")
	TEST_ASSERT(shoes.signal_procs?[clown], "Clown shoes do not listen for steps")
	clown.drop_inv_item_on_ground(shoes)
	TEST_ASSERT(!waddle.signal_procs?[clown], "The wearer still waddles without the shoes")
	TEST_ASSERT(!shoes.signal_procs?[clown], "The shoes still listen for steps")
	var/mob/living/simple_animal/hostile/retaliate/clown/mob_clown = allocate(/mob/living/simple_animal/hostile/retaliate/clown)
	TEST_ASSERT(mob_clown.GetComponent(/datum/component/footstep), "The clown mob has no footsteps")
	TEST_ASSERT(waddle.signal_procs?[mob_clown], "The clown mob does not waddle")
